<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- OutputSwitcherSpike: debug only -->
        <provider
            android:name="com.metrolist.android.outputswitcher.OutputSwitcherSpikeInitializer"
            android:authorities="${applicationId}.outputswitcher-spike"
            android:exported="false" />

        <activity
            android:name="com.metrolist.android.outputswitcher.TransferMediaActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.media.action.TRANSFER_MEDIA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
